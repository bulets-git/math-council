# PostgreSQL
POSTGRES_USER=mathcouncil
POSTGRES_PASSWORD=mathcouncil_dev_secret
POSTGRES_DB=mathcouncil_db
POSTGRES_PORT=5432

# Backend FastAPI
DATABASE_URL=postgresql+asyncpg://mathcouncil:mathcouncil_dev_secret@db:5432/mathcouncil_db
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# Frontend Next.js
INTERNAL_API_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000


# LLM Multi-Provider Gateway
DEFAULT_LLM_PROVIDER=mock
OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPATIBLE_API_KEY=your_openrouter_or_openai_compatible_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here