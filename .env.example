# PostgreSQL
POSTGRES_USER=mathcouncil
POSTGRES_PASSWORD=mathcouncil_dev_secret
POSTGRES_DB=mathcouncil_db
POSTGRES_PORT=5432

# Backend FastAPI
DATABASE_URL=postgresql+asyncpg://mathcouncil:mathcouncil_dev_secret@db:5432/mathcouncil_db
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# Frontend Next.js
INTERNAL_API_URL=http://api:8000
NEXT_PUBLIC_API_URL=http://localhost:8000


# LLM Multi-Provider Gateway (4 Independent Providers)
DEFAULT_LLM_PROVIDER=mock

# 1. Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Alibaba Cloud Model Studio (MaaS)
ALIBABA_BASE_URL=https://ws-dgcpkbso457jl8mu.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
ALIBABA_API_KEY=your_alibaba_api_key_here

# 3. DeepSeek Native
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 4. DeepInfra
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_API_KEY=your_deepinfra_api_key_here

# Default Role Mappings:
ROLE_NORMALIZER_MODEL=gemini:gemini-2.5-flash
ROLE_SOURCE_FINDER_MODEL=gemini:gemini-2.5-flash
ROLE_SOLVER_A_MODEL=alibaba:qwen2.5-math-72b-instruct
ROLE_SOLVER_B_MODEL=deepseek:deepseek-reasoner
ROLE_SOLVER_C_MODEL=deepinfra:Qwen/Qwen2.5-72B-Instruct
ROLE_SKEPTIC_MODEL=deepinfra:meta-llama/Llama-3.3-70B-Instruct
ROLE_JUDGE_MODEL=deepinfra:Qwen/Qwen2.5-72B-Instruct